# Copy to /etc/dsh-auth/feishu-auth.env and chmod 600.
# Do not commit real values or paste them into chat.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=
FEISHU_API_BASE_URL=https://open.feishu.cn
FEISHU_REQUEST_TIMEOUT_MS=15000
FEISHU_PAGE_SIZE=500
FEISHU_FIELD_USERNAME=账号
FEISHU_FIELD_PASSWORD_HASH=密码哈希
FEISHU_FIELD_ENABLED=启用
DSH_USERS_FILE=/root/.dsh/auth/users.yaml
DSH_LOCAL_USERS_FILE=/etc/dsh-auth/users.local.yaml
DSH_USERS_METADATA_FILE=/root/.dsh/auth/users.yaml.meta.json
DSH_MAX_STALE_SECONDS=600
DSH_ALLOW_EMPTY_REMOTE=false
